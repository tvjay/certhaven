[Unit]
Description=certhaven database backup
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/lib/certhaven/certhaven-backup
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/backups
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
LockPersonality=yes
