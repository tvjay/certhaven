[Unit]
Description=certhaven email alerts (expiry, CRLs, failed logins)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=certhaven
Group=certhaven
WorkingDirectory=/usr/lib/certhaven
Environment=CERTHAVEN_DATA_DIR=/var/lib/certhaven
ExecStart=/usr/bin/flask --app wsgi notify
UMask=0077
LimitCORE=0

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/certhaven
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
CapabilityBoundingSet=
